# SandboxEDU Configuration
# คัดลอกไฟล์นี้เป็น .env และกรอกค่าจริง

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# API Base URL 
EXPO_PUBLIC_API_BASE_URL=https://api.sandboxedu.app

# JWT สำหรับเทส (รับจาก POST /users/revalidate)
EXPO_PUBLIC_JWT_TEST=your-jwt-secret-here

# Environment
# ตั้งเป็น "development" เพื่อใช้ JWT_TEST และ bypass login
# ตั้งเป็น "production" เพื่อใช้ Supabase login ปกติ
EXPO_PUBLIC_ENV=development

# Debug
EXPO_PUBLIC_DEBUG_API=false
