# SandboxEDU API Configuration
# คัดลอกไฟล์นี้เป็น .env และกรอกค่าจริง

# API Base URL
EXPO_PUBLIC_API_BASE_URL=https://api.sandboxedu.app

# API Version (optional)
EXPO_PUBLIC_API_VERSION=v1

# Environment
EXPO_PUBLIC_ENV=development

# Feature Flags
EXPO_PUBLIC_ENABLE_SYNC=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true

# Debug
EXPO_PUBLIC_DEBUG_API=false
