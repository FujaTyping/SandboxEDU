# SandboxEDU Configuration
# 1. คัดลอกไฟล์นี้: copy .env.example .env
# 2. กรอกค่า EXPO_PUBLIC_SUPABASE_URL และ EXPO_PUBLIC_SUPABASE_ANON_KEY จาก Supabase Dashboard

# Supabase — รับค่าจาก https://supabase.com/dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# API Base URL (ค่านี้ใช้ได้เลย ไม่ต้องแก้)
EXPO_PUBLIC_API_BASE_URL=xxxx

# Environment
EXPO_PUBLIC_ENV=development
